# ==============================================================================
# CONFIGURATION D'ENVIRONNEMENT RUN AUTO MARSEILLE
# Copiez ce fichier vers .env.local (développement) ou renseignez ces variables
# dans le tableau de bord de votre hébergeur (Vercel > Settings > Environment Variables).
# ==============================================================================

# Mot de passe de l'interface d'administration (/admin) — OBLIGATOIRE.
# Aucun mot de passe par défaut n'existe : sans cette variable, l'espace admin est désactivé.
# En production : 10 caractères minimum, l'ancien mot de passe de démonstration est refusé.
ADMIN_PASSWORD=

# (Recommandé) Secret de signature des sessions admin, 32 caractères aléatoires minimum.
# Exemple de génération : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si absent, un secret est dérivé du mot de passe (changer le mot de passe déconnecte alors toutes les sessions).
ADMIN_SESSION_SECRET=

# URL publique de l'application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# SERVICE TRANSACTIONNEL D'E-MAILS (Optionnel - Resend)
# Si cette clé est renseignée, les confirmations de rendez-vous sont envoyées
# automatiquement par email au client et au garage.
# En l'absence de clé, les emails sont enregistrés et journalisés en console sans erreur.
# ------------------------------------------------------------------------------
RESEND_API_KEY=

# Expéditeur des e-mails. Sans domaine vérifié dans Resend, laissez vide (onboarding@resend.dev est utilisé,
# et Resend n'envoie alors qu'à l'adresse e-mail du compte Resend).
# Une fois le domaine acheté et vérifié : EMAIL_FROM="Run Auto <notifications@votre-domaine.fr>"
EMAIL_FROM=

# Adresse qui reçoit une alerte à chaque nouvelle demande de rendez-vous (le patron)
GARAGE_NOTIFICATION_EMAIL=

# ------------------------------------------------------------------------------
# BASE DE DONNÉES SUPABASE (OBLIGATOIRE EN PRODUCTION / VERCEL)
# Sans ces clés, le site utilise data/storage.json, ce qui ne fonctionne qu'en local.
# La clé service_role est secrète : ne jamais la préfixer par NEXT_PUBLIC_.
# Mise en place :
# 1. Créez un projet sur https://supabase.com
# 2. Exécutez le script SQL présent dans supabase/schema.sql
# 3. Renseignez les deux clés ci-dessous :
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# ANTI-ROBOT CLOUDFLARE TURNSTILE (Recommandé en production)
# Gratuit : https://dash.cloudflare.com > Turnstile > Add widget (domaine du site, mode "Managed").
# Sans ces clés, les formulaires restent protégés par le honeypot et la limitation de requêtes.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
